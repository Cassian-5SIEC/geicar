<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="arm_tree">
		<Fallback>
			<Sequence>
				<SendControlMsg name="send_stop_msg"
						topic_name="/control_msg"
						command="stop"/>
				<Sleep msec="1000"/>
				<TrashLocalizationService service_name="/trash_localization_node/publish_target_tf"/>
				<CheckTargetInRange name="check_target_in_range"
									max_range="0.42"
									min_range="0.30"/>
				<Fallback>
						<ExecutePickPlace name="pick_place_action"
									gripper_approach_offset_coeff="0.10"
									gripper_asym_offset_angle="0.21"/>
						<RetractArm name="retract_arm_action"/>
				</Fallback>
				<TrashLocalizationService service_name="/trash_localization_node/clear_target_tf"/>
				<SendControlMsg name="send_start_msg"
								topic_name="/control_msg"
								command="start"/>
			</Sequence>
			<Inverter>
			<SendControlMsg name="send_start_msg"
							topic_name="/control_msg"
							command="start"/>
			</Inverter>
			
		</Fallback>
  </BehaviorTree>
</root>

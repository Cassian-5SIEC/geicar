<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="teleop_tree">
    <Sequence>
      <TrashLocalizationService service_name="/trash_localization_node/publish_target_tf"/>
      <CheckTargetInRange name="check_target_in_range"
                          max_range="0.41"
                          min_range="0.32"/>
      <Sequence>
        <CheckForStopMsg topic_name="/stop_command" stop_state="{stop_state}"/>

        <Switch2 variable="{stop_state}" case_1="start" case_2="stop">
          <!-- <AlwaysSuccess/>     -->
          <SendControlMsg name="send_stop_msg"
                topic_name="/control_msg"
                command="stop"/>
          
          <AlwaysSuccess/>
          <AlwaysFailure/> 
        </Switch2>

		  </Sequence>

      <SendControlMsg name="send_trash_detected_msg"
                      topic_name="/control_msg"
                      command="trash-detected"/>

            <!-- <Sequence>
      <CheckForStopMsg topic_name="/stop" stop_state="{stop_state}"/>

        <Switch2 variable="{stop_state}" case_1="stop" case_2="start">
          <SendControlMsg name="send_start_msg"
						topic_name="/control_msg"
						command="start"/>
          <AlwaysSuccess/>
          <AlwaysFailure/> 
        </Switch2>

		  </Sequence> -->

      <CheckForRecentRequest name="check_for_recent_request"
                             topic_name="/recent_request_hmi"/>
      <RetryUntilSuccessful num_attempts="3">
        <SubTree ID="arm_tree"
                _autoremap="true"/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

</root>

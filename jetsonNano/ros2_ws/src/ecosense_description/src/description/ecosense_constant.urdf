<?xml version="1.0" ?>
<robot name="ecosense" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Define chassis constants -->
    <xacro:property name="base_width" value="0.523"/> <!-- Meters -->
    <xacro:property name="base_length" value="0.985"/>
    <xacro:property name="base_height" value="0.2"/>

    <xacro:property name="wheel_radius" value="0.095"/>
    <xacro:property name="wheel_width" value="0.076"/>
    <xacro:property name="wheel_xgap" value="0.567"/>
    <xacro:property name="wheel_ygap" value="0.447"/>
    <xacro:property name="wheel_xoff" value="0.2835"/>
    <xacro:property name="wheel_yoff" value="0.2235"/>
    <xacro:property name="wheel_zoff" value="0.0"/>

    <xacro:property name="wheel_left_steer_limit_left" value="0.401425727959"/> <!-- 23 degrees -->
    <xacro:property name="wheel_left_steer_limit_right" value="0.418879020479"/> <!-- 24 degrees -->
    <xacro:property name="wheel_right_steer_limit_left" value="0.471238898038"/> <!-- 27 degrees -->
    <xacro:property name="wheel_right_steer_limit_right" value="0.453785605519"/> <!-- 26 degrees -->

    <xacro:property name="arm_mount_xoff" value="0.6"/>
    <xacro:property name="arm_mount_yoff" value="0.05"/>
    <xacro:property name="arm_mount_zoff" value="0.0"/>
    <!-- Define sensors constants -->
    <!-- RPLidar -->
    <xacro:property name="rplidar_xoff" value="-0.34"/>
    <xacro:property name="rplidar_yoff" value="0.0"/>
    <xacro:property name="rplidar_zoff" value="0.45"/>
    <xacro:property name="rplidar_rotz" value="${pi/2 - pi/22.5}"/>

    <!-- IMU -->
    <xacro:property name="imu_xoff" value="-0.16"/>
    <xacro:property name="imu_yoff" value="0.065"/>
    <xacro:property name="imu_zoff" value="0.16"/>

    <!-- Ultrasonics -->
    <xacro:property name="ultrasonic_front_central_xoff" value="0.54"/>
    <xacro:property name="ultrasonic_front_central_yoff" value="0.0"/>
    <xacro:property name="ultrasonic_front_central_zoff" value="0.0"/>

    <xacro:property name="ultrasonic_front_left_xoff" value="0.50"/>
    <xacro:property name="ultrasonic_front_left_yoff" value="0.16"/>
    <xacro:property name="ultrasonic_front_left_zoff" value="0.0"/>

    <xacro:property name="ultrasonic_front_right_xoff" value="0.50"/>
    <xacro:property name="ultrasonic_front_right_yoff" value="-0.16"/>
    <xacro:property name="ultrasonic_front_right_zoff" value="0.0"/>

    <xacro:property name="ultrasonic_back_central_xoff" value="-0.4"/>
    <xacro:property name="ultrasonic_back_central_yoff" value="0.0"/>
    <xacro:property name="ultrasonic_back_central_zoff" value="0.0"/>

    <xacro:property name="ultrasonic_back_left_xoff" value="-0.40"/>
    <xacro:property name="ultrasonic_back_left_yoff" value="0.10"/>
    <xacro:property name="ultrasonic_back_left_zoff" value="0.0"/>

    <xacro:property name="ultrasonic_back_right_xoff" value="-0.40"/>
    <xacro:property name="ultrasonic_back_right_yoff" value="-0.10"/>
    <xacro:property name="ultrasonic_back_right_zoff" value="0.0"/>

    <!-- Camera Left (Need remeasure) -->
    <xacro:property name="camera_left_xoff" value="0.0"/>
    <xacro:property name="camera_left_yoff" value="0.0"/>
    <xacro:property name="camera_left_zoff" value="0.0"/>

    <!-- Camera Right (Need remeasure) -->
    <xacro:property name="camera_right_xoff" value="0.0"/>
    <xacro:property name="camera_right_yoff" value="0.0"/>
    <xacro:property name="camera_right_zoff" value="0.0"/>

</robot>   
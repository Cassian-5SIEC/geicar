<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="main">
    <BehaviorTree ID="main">
        <Delay delay_msec="3000">
            <Sequence>
                <ForceSuccess>
                    <CheckTargetInRange name="check_target_in_range"
                                        max_range="0.38"
                                        min_range="0.32"/>
                </ForceSuccess>
                <Fallback>
                    <ExecutePickPlace   name="pick_place_action"/>
                    <RetractArm   name="retract_arm_action"/>
                </Fallback>
            </Sequence>
        </Delay>
    </BehaviorTree>

    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="ExecutePickPlace"
                editable="true">
        </Action>
		<Action ID="CheckTargetInRange"
				editable="true">
            <input_port name="max_range"/>
            <input_port name="min_range"/>
        </Action>
        <Action ID="RetractArm"
                editable="true">
        </Action>
    </TreeNodesModel>

</root>